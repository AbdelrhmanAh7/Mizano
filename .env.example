# ============================================
# MIZANO ERP - Environment Template
# ============================================
# Copy this file to .env.local for local development.

APP_ENV=local
NODE_ENV=development

# ── Node Memory Limits ──────────────────────────────────────
# Optional: Cap Node V8 heap space in MB (integer between 128 and 4096).
# When unset, Node defaults are used. Suggested for Raspberry Pi 5 (8GB): 1024.
# MIZANO_NODE_HEAP_MB=1024

# ── Database ──────────────────────────────────────────────
DATABASE_URL="postgresql://mizano:mizano_secret@localhost:5435/mizano_dev?schema=public"

# ── Redis ─────────────────────────────────────────────────
REDIS_URL="redis://localhost:6380"

# ── JWT Authentication ────────────────────────────────────
JWT_SECRET=local-dev-jwt-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=local-dev-jwt-refresh-secret-at-least-32-characters-long
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ── NextAuth ──────────────────────────────────────────────
NEXTAUTH_SECRET=local-dev-nextauth-secret-key-minimum-32-chars
NEXTAUTH_URL=http://localhost:5001
