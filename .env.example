# ============================================
# MIZANO ERP - Environment Template
# ============================================
# Copy this file to .env.local for local development.

# ── Database / Redis passwords (production compose stacks) ──
# POSTGRES_PASSWORD is REQUIRED: docker-compose.production.yml and
# deploy/pi/docker-compose.pi.yml refuse to start without it (:?).
# REDIS_PASSWORD is optional; Redis --requirepass falls back to POSTGRES_PASSWORD.
# The API gets it raw next to REDIS_URL and percent-encodes it itself, so any
# characters work, except a single quote (the compose files carry it in a
# single-quoted YAML list). Leave it empty locally when your Redis has no password.
# A POSTGRES_PASSWORD with URL-special characters (/ + = @ : % ?) must be
# percent-encoded inside DATABASE_URL.
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# ── Node Memory Limits ──────────────────────────────────────
# Optional: Cap Node V8 heap space in MB (integer between 128 and 4096).
# Must be exported in the service/process environment (shell, systemd, or container env)
# before the launcher starts Node. When unset, Node defaults are used.
# Suggested starting value for Raspberry Pi 5 (8GB): 1024.
# Note: In containerized setups, MIZANO_NODE_HEAP_MB must be passed in the compose profile (#39).
# MIZANO_NODE_HEAP_MB=1024
