# ============================================
# MIZANO ERP - Environment Template
# ============================================
# Copy this file to .env.local for local development.

# ── Trusted proxies ─────────────────────────────────────────
# Optional: comma-separated CIDRs (or single IPs) of reverse proxies allowed to set X-Forwarded-For.
# Loopback (127.0.0.0/8, ::1) is always trusted (Tailscale serve). Login throttling and req.ip use
# the right-most X-Forwarded-For hop not in this list; any other peer is keyed on its socket address.
# Add only your proxy, e.g. the cloudflared container (deploy/pi pins it to 172.30.184.250).
# An invalid entry stops the API at startup; the effective list is logged once at boot.
# TRUSTED_PROXY_CIDRS=172.30.184.250/32

# ── Node Memory Limits ──────────────────────────────────────
# Optional: Cap Node V8 heap space in MB (integer between 128 and 4096).
# Must be exported in the service/process environment (shell, systemd, or container env)
# before the launcher starts Node. When unset, Node defaults are used.
# Suggested starting value for Raspberry Pi 5 (8GB): 1024.
# Note: In containerized setups, MIZANO_NODE_HEAP_MB must be passed in the compose profile (#39).
# MIZANO_NODE_HEAP_MB=1024

# ── Integrations (FlowLine connector) ───────────────────────
# Required before webhook endpoints can be saved: encrypts webhook signing secrets at rest
# (AES-256-GCM). 32+ random characters, e.g. `openssl rand -base64 48`. No default; keep it
# stable (rotating it makes stored secrets unreadable: re-enter them in Settings).
# INTEGRATIONS_ENCRYPTION_KEY=
# Optional: public HTTPS address FlowLine uses, shown on Settings → Connect to FlowLine
# (default: NEXT_PUBLIC_API_URL + /integrations/v1).
# NEXT_PUBLIC_INTEGRATIONS_BASE_URL=https://mizano.example.com/api/integrations/v1
# Local testing only: allow http:// and private-network webhook targets (never in production).
# INTEGRATIONS_ALLOW_PRIVATE_WEBHOOKS=false
# Set to false to pause outbound webhook delivery and the overdue scan (events still queue).
# INTEGRATIONS_DISPATCH_ENABLED=true

# ── AI (optional, the organization's own account) ──────────
# Each organization connects its own Claude, OpenAI, Gemini or OpenRouter key in Settings → AI
# (sealed with INTEGRATIONS_ENCRYPTION_KEY). Nothing here is needed for that.
# Optional: a self-hosted Ollama server organizations may choose (operator-set, never by tenants).
# AI_OLLAMA_BASE_URL=http://127.0.0.1:11434
# Force the CPU rules reader for every upload, even for organizations with AI on.
# INTAKE_EXTRACTION_STRATEGY=rules

# ── Password reset email ────────────────────────────────────
# Mail server for "Forgot password" links. When unset, the account's organization SMTP settings
# are used; with neither, no link is sent (the screen still gives its usual answer).
# MAIL_SMTP_HOST=smtp.example.com
# MAIL_SMTP_PORT=587
# MAIL_SMTP_USER=
# MAIL_SMTP_PASSWORD=
# MAIL_FROM=Jarda <no-reply@example.com>
# Web address used in reset links (default: the first CORS_ORIGIN entry).
# WEB_APP_URL=https://mizano.example.com

# ── AI apps over MCP (the owner's Claude, ChatGPT, Codex or Gemini) ──
# Public origin of the API (the hostname that serves /mcp, /oauth/* and /.well-known/*), e.g. the
# api hostname from deploy/pi. Optional override: defaults to PUBLIC_API_URL (Pi) then
# NEXT_PUBLIC_API_URL (server), removing the /api prefix. Without any public API setting,
# production keeps the connection off; development uses http://localhost:<API_PORT>.
# An HTTP fallback also keeps production MCP off: use an HTTPS API address.
# The consent screen and document links use FRONTEND_URL
# (or the first CORS_ORIGIN entry).
# MCP_PUBLIC_URL=https://api.mizano.example.com
# PUBLIC_API_URL=https://api.mizano.example.com/api
# NEXT_PUBLIC_API_URL=https://api.mizano.example.com/api
