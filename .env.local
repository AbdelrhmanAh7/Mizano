# ============================================
# MIZANO ERP - Local Development Environment
# ============================================
# This is the default environment for localhost development.
# Copy to .env and adjust values as needed.
#
# APP_ENV=local  |  NODE_ENV=development
# ============================================

APP_ENV=local

# ── Database ──────────────────────────────────────────────
# Port 5435 avoids conflict with local PostgreSQL
DATABASE_URL="postgresql://mizano:mizano_secret@localhost:5435/mizano_db?schema=public"

# ── Redis ─────────────────────────────────────────────────
REDIS_URL="redis://localhost:6380"

# ── JWT Authentication ────────────────────────────────────
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# ── NextAuth (Frontend Auth) ──────────────────────────────
NEXTAUTH_SECRET="your-nextauth-secret-change-in-production"
NEXTAUTH_URL="http://localhost:5001"

# ── API Configuration ─────────────────────────────────────
API_URL="http://localhost:6001"
API_PORT=6001
NODE_ENV="development"
CORS_ORIGIN="http://localhost:5001"

# ── Frontend ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:6001"
NEXT_PUBLIC_APP_NAME="Mizano"

# ── Rate Limiting ─────────────────────────────────────────
RATE_LIMIT_TTL=1000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_MAX=100

# ── Logging ───────────────────────────────────────────────
LOG_LEVEL=debug

# ── OCR Service (PaddleOCR + Tesseract, no GPU needed) ───
OCR_SERVICE_URL=http://localhost:7001
OCR_SERVICE_TIMEOUT_MS=60000

# ── VLM Service (requires GPU) ───────────────────────────
VLM_SERVICE_URL=http://localhost:8100
VLM_TIMEOUT_MS=120000
VLM_ENABLED=true
VLM_MODEL_NAME=Qwen/Qwen2.5-VL-7B-Instruct-AWQ

# ── SMTP / Email (optional for local) ────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your_app_password
# SMTP_FROM_EMAIL=noreply@localhost
# SMTP_FROM_NAME=Mizano ERP


# ── Ollama (local or Colab tunnel) ───────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=qwen3-vl:8b
OLLAMA_TEXT_MODEL=qwen3-vl:8b
OLLAMA_FAST_MODEL=qwen2.5:7b
OLLAMA_SLOW_MODEL=qwen3-vl:8b
OLLAMA_TIMEOUT_MS=300000
OLLAMA_ENABLED=true
OLLAMA_MAX_CONCURRENT=1
OLLAMA_NUM_THREAD=4
OLLAMA_NUM_CTX=8192
OLLAMA_NLP_MODEL=qwen3-vl:8b
OLLAMA_FORECASTING_MODEL=qwen3-vl:8b
OLLAMA_WEBHOOK_SECRET=mizano-ollama-local-dev

# ── Document Extraction Strategy ─────────────────────────
EXTRACTION_STRATEGY=vlm
EXTRACTION_OCR_CONFIDENCE_THRESHOLD=70
PADDLE_OCR_LANG=ar
PADDLE_OCR_PKG_PATH=C:/paddleocr_pkg
PADDLE_OCR_MODELS_DIR=C:/paddleocr_pkg/arabic_models
PADDLE_OCR_TIMEOUT_MS=120000
EXTRACTION_MAX_PDF_PAGES=3

# ── Credential rotation (#104) ────────────────────────
# Rotation dates (YYYY-MM-DD, UTC; the date only, never the secret). The API logs
# ok/due/expired/unknown per credential at boot; rotate at least every 90 days (#104).
TELEGRAM_BOT_TOKEN_CREDENTIAL_ROTATED_AT=
CLOUDFLARE_TUNNEL_TOKEN_CREDENTIAL_ROTATED_AT=
