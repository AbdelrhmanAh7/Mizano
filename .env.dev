# ============================================
# MIZANO ERP - Development Server Environment
# ============================================
# For shared development servers. Replace __CHANGE_ME__ placeholders.
#
# APP_ENV=dev  |  NODE_ENV=development
# ============================================

APP_ENV=dev

# ── Database ──────────────────────────────────────────────
POSTGRES_USER=mizano
POSTGRES_PASSWORD=__CHANGE_ME__
POSTGRES_DB=mizano_db
DATABASE_URL="postgresql://mizano:__CHANGE_ME__@postgres:5432/mizano_db?schema=public"

# ── Redis ─────────────────────────────────────────────────
REDIS_URL="redis://redis:6379"

# ── JWT Authentication ────────────────────────────────────
# Generate: openssl rand -base64 64
JWT_SECRET=__CHANGE_ME__
JWT_REFRESH_SECRET=__CHANGE_ME__
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ── NextAuth (Frontend Auth) ──────────────────────────────
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=__CHANGE_ME__
NEXTAUTH_URL=http://dev.yourdomain.com

# ── API Configuration ─────────────────────────────────────
API_PORT=6001
NODE_ENV=development
CORS_ORIGIN=http://dev.yourdomain.com

# ── Frontend ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://api-dev.yourdomain.com
NEXT_PUBLIC_APP_NAME=Mizano

# ── Rate Limiting ─────────────────────────────────────────
RATE_LIMIT_TTL=1000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_MAX=100

# ── Logging ───────────────────────────────────────────────
LOG_LEVEL=debug

# ── Ollama AI ────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_ENABLED=true
OLLAMA_TEXT_MODEL=qwen3-vl:8b
OLLAMA_VISION_MODEL=qwen3-vl:8b
OLLAMA_FAST_MODEL=qwen2.5:7b
OLLAMA_SLOW_MODEL=qwen3-vl:8b
OLLAMA_TIMEOUT_MS=300000
OLLAMA_MAX_CONCURRENT=1
OLLAMA_NUM_CTX=8192

# ── SMTP / Email ─────────────────────────────────────────
SMTP_HOST=__CHANGE_ME__
SMTP_PORT=587
SMTP_USER=__CHANGE_ME__
SMTP_PASSWORD=__CHANGE_ME__
SMTP_FROM_EMAIL=noreply@dev.yourdomain.com
SMTP_FROM_NAME=Mizano ERP

# ── Credential rotation (#104) ────────────────────────
# Rotation dates (YYYY-MM-DD, UTC; the date only, never the secret). The API logs
# ok/due/expired/unknown per credential at boot; rotate at least every 90 days (#104).
TELEGRAM_BOT_CREDENTIAL_ROTATED_AT=
CLOUDFLARE_TUNNEL_CREDENTIAL_ROTATED_AT=
