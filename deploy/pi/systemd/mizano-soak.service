[Unit]
Description=Mizano soak-test resource sample (docker stats, free, OOM counters)
After=docker.service
# Never sample before the SSD is mounted (samples must not land on the SD card).
RequiresMountsFor=/mnt/ssd/mizano

[Service]
Type=oneshot
ExecStart=/opt/mizano/deploy/pi/scripts/soak-sample.sh
