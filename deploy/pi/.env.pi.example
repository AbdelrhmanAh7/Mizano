# Template for deploy/pi/.env.pi. Copy, chmod 600, fill in. Never commit .env.pi.
# Validate with: APP_ENV=pi pnpm env:check
# Generate secrets with: openssl rand -base64 48
# Keys left empty here are optional; every other key is required.

# --- Images (pinned by digest at deploy time by scripts/deploy.sh) ---
MIZANO_API_IMAGE=ghcr.io/OWNER/mizano-api@sha256:REPLACE_WITH_DIGEST
MIZANO_WEB_IMAGE=ghcr.io/OWNER/mizano-web@sha256:REPLACE_WITH_DIGEST

# --- Storage: a directory on the SSD mount, never the SD card ---
MIZANO_DATA_DIR=/mnt/ssd/mizano

# --- Database / cache ---
POSTGRES_USER=mizano
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=mizano_db
# Same user/password/db as above; URL-encode special characters in the password
DATABASE_URL=postgresql://mizano:REPLACE_ME@postgres:5432/mizano_db
REDIS_URL=redis://redis:6379

# --- Auth (each at least 32 characters, all different) ---
JWT_SECRET=REPLACE_ME
JWT_REFRESH_SECRET=REPLACE_ME
NEXTAUTH_SECRET=REPLACE_ME

# --- Public origins (two hostnames; see README) ---
# Web hostname: used for NextAuth and as the single allowed CORS origin
NEXTAUTH_URL=https://app.example.com
CORS_ORIGIN=https://app.example.com
# NEXT_PUBLIC_API_URL is inlined into the web image at BUILD time (#38) and must be
# https://api.example.com/api for this deployment. Recorded here for operator reference only.
PUBLIC_API_URL=https://api.example.com/api

# --- Reverse proxy: Cloudflare Tunnel ---
CLOUDFLARE_TUNNEL_TOKEN=REPLACE_ME

# --- AI (demo: CPU-only, paid cloud AI disabled) ---
OLLAMA_ENABLED=false
# Intake worker: CPU rules/OCR extraction, one document at a time on the Pi
INTAKE_EXTRACTION_STRATEGY=rules
INTAKE_CONCURRENCY=1
# Directory with pinned *.traineddata inside the worker image (optional until the
# image bakes them in; without it tesseract.js would try to download at runtime)
INTAKE_TESSDATA_DIR=

# --- Alerts (Telegram Bot API, optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

# --- Backups ---
# age PUBLIC key (age1...). Keep the private identity off the Pi.
BACKUP_AGE_RECIPIENT=age1REPLACE_ME
BACKUP_RETENTION_DAYS=14
