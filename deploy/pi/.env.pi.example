# Copy to .env.pi (chmod 600) and fill in. Never commit real values.
# Generate secrets with: openssl rand -base64 48

# --- Images (pinned by digest at deploy time by scripts/deploy.sh) ---
MIZANO_API_IMAGE=ghcr.io/OWNER/mizano-api@sha256:REPLACE_WITH_DIGEST
MIZANO_WEB_IMAGE=ghcr.io/OWNER/mizano-web@sha256:REPLACE_WITH_DIGEST

# --- Storage ---
MIZANO_DATA_DIR=/mnt/ssd/mizano

# --- Database / cache ---
POSTGRES_USER=mizano
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=mizano_db
# URL-encode special characters in the password
DATABASE_URL=postgresql://mizano:REPLACE_ME@postgres:5432/mizano_db
REDIS_URL=redis://redis:6379

# --- Auth ---
JWT_SECRET=REPLACE_ME
JWT_REFRESH_SECRET=REPLACE_ME
NEXTAUTH_SECRET=REPLACE_ME

# --- Public origins (two hostnames; see README) ---
# Web hostname: used for NextAuth and as the single allowed CORS origin
NEXTAUTH_URL=https://app.example.com
CORS_ORIGIN=https://app.example.com
# NEXT_PUBLIC_API_URL is inlined into the web image at BUILD time (#38) and must be
# https://api.example.com/api for this deployment. Recorded here for operator reference only.
PUBLIC_API_URL=https://api.example.com/api

# --- Cloudflare Tunnel ---
CLOUDFLARE_TUNNEL_TOKEN=REPLACE_ME

# --- AI (demo: paid cloud AI disabled) ---
OLLAMA_ENABLED=false

# --- Alerts (Telegram Bot API) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

# --- Backups ---
# age PUBLIC key (age1...). Keep the private identity off the Pi.
BACKUP_AGE_RECIPIENT=age1REPLACE_ME
BACKUP_RETENTION_DAYS=14

# CPU worker: 2 only after Pi measurements; provisional total job deadline.
INTAKE_CONCURRENCY=1
INTAKE_JOB_DEADLINE_MS=120000
