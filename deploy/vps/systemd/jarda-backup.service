[Unit]
Description=Jarda nightly encrypted backup (local, then Cloudflare R2 when enabled)
Requires=docker.service
After=docker.service jarda-stack.service

[Service]
Type=oneshot
Environment=ENV_FILE=/etc/jarda/jarda.env
ExecStart=/opt/jarda/deploy/vps/scripts/backup.sh
Nice=10
IOSchedulingClass=idle
