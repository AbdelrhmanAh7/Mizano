{
  "name": "mizano",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered ERP system - Autonomous Accounting Platform",
  "scripts": {
    "// — Development ——————————————————": "",
    "dev": "docker-compose up -d && turbo dev",
    "dev:local": "APP_ENV=local pnpm dev",
    "dev:codespaces": "bash .devcontainer/start.sh",
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter @mizano/web dev",
    "// — Build ————————————————————————": "",
    "build": "turbo build",
    "build:dev": "APP_ENV=dev turbo build",
    "build:sit": "APP_ENV=sit turbo build",
    "build:prod": "APP_ENV=prod turbo build",
    "// — Code Quality —————————————————": "",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "lint:deadcode": "knip",
    "lint:duplication": "jscpd",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "type-check": "turbo type-check",
    "validate": "turbo lint type-check",
    "// — Testing ——————————————————————": "",
    "test": "turbo test",
    "test:api": "pnpm --filter api test",
    "test:web": "pnpm --filter @mizano/web test",
    "test:watch": "pnpm --filter api test:watch",
    "test:cov": "pnpm --filter api test:cov",
    "test:e2e": "pnpm --filter api test:e2e",
    "// — CI ———————————————————————————": "",
    "ci": "turbo lint type-check test && pnpm format",
    "ci:full": "turbo lint type-check test && pnpm lint:deadcode && pnpm lint:duplication",
    "// — Database (Prisma) ————————————": "",
    "db:generate": "pnpm --filter api exec prisma generate",
    "db:push": "pnpm --filter api exec prisma db push",
    "db:migrate": "pnpm --filter api exec prisma migrate dev",
    "db:reset": "pnpm --filter api exec prisma migrate reset --force && pnpm db:seed",
    "db:seed": "pnpm --filter api exec prisma db seed",
    "db:studio": "pnpm --filter api exec prisma studio",
    "db:check": "pnpm --filter api exec prisma validate",
    "// — Docker / Infrastructure ——————": "",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:dev": "docker-compose --env-file .env.dev up -d",
    "docker:sit": "docker-compose --env-file .env.sit -f docker-compose.yml -f docker-compose.sit.yml up -d",
    "docker:prod": "docker-compose --env-file .env.prod -f docker-compose.production.yml up -d --build",
    "docker:prod:down": "docker-compose -f docker-compose.production.yml down",
    "status": "docker-compose ps",
    "// — Utilities ————————————————————": "",
    "env:check": "node scripts/check-env.js",
    "generate:types": "pnpm --filter @mizano/shared-types build",
    "generate:validators": "pnpm --filter @mizano/validators build",
    "clean": "turbo clean && node -e \"const fs=require('fs');['node_modules','.turbo'].forEach(d=>fs.rmSync(d,{recursive:true,force:true}))\"",
    "clean:full": "turbo clean && node -e \"const fs=require('fs');['node_modules','.turbo','apps/web/.next','apps/api/dist','packages/shared-types/dist','packages/validators/dist','coverage'].forEach(d=>fs.rmSync(d,{recursive:true,force:true}))\"",
    "prepare": "husky",
    "e2e": "playwright test",
    "e2e:up": "e2e-browser/up.sh",
    "e2e:down": "e2e-browser/down.sh",
    "e2e:happy": "playwright test --grep @happy",
    "e2e:edge": "playwright test --grep @edge"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^20.11.0",
    "husky": "^9.1.7",
    "jscpd": "^4.3.0",
    "knip": "^5.88.1",
    "prettier": "^3.2.4",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "packageManager": "pnpm@8.14.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "pnpm": {
    "neverBuiltDependencies": [
      "gl"
    ]
  },
  "dependencies": {
    "@img/sharp-linux-x64": "^0.34.5"
  }
}
