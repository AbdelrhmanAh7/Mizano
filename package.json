{
  "name": "mizano",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered ERP system - Autonomous Accounting Platform",
  "scripts": {
    "// — Development ——————————————————": "",
    "dev": "docker-compose up -d && turbo dev",
    "dev:local": "APP_ENV=local pnpm dev",
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter @mizano/web dev",
    "dev:ocr": "docker-compose --profile ocr up -d",
    "dev:vlm": "docker-compose --profile vlm up -d",
    "dev:with-ocr": "docker-compose --profile ocr up -d && turbo dev",
    "// — Build ————————————————————————": "",
    "build": "turbo build",
    "build:dev": "APP_ENV=dev turbo build",
    "build:sit": "APP_ENV=sit turbo build",
    "build:prod": "APP_ENV=prod turbo build",
    "// — Code Quality —————————————————": "",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "type-check": "turbo type-check",
    "validate": "turbo lint type-check",
    "// — Testing ——————————————————————": "",
    "test": "turbo test",
    "test:api": "pnpm --filter api test",
    "test:web": "pnpm --filter @mizano/web test",
    "test:watch": "pnpm --filter api test:watch",
    "test:cov": "pnpm --filter api test:cov",
    "test:e2e": "pnpm --filter api test:e2e",
    "test:regression": "pnpm --filter api test -- --testPathPattern=regression",
    "test:regression:web": "pnpm --filter @mizano/web test -- --testPathPattern=regression",
    "test:playwright": "pnpm --filter @mizano/web exec playwright test",
    "// — CI ———————————————————————————": "",
    "ci": "turbo lint type-check test",
    "ci:full": "turbo lint type-check test && pnpm format && pnpm test:e2e",
    "// — Database (Prisma) ————————————": "",
    "db:generate": "pnpm --filter api exec prisma generate",
    "db:push": "pnpm --filter api exec prisma db push",
    "db:migrate": "pnpm --filter api exec prisma migrate dev",
    "db:reset": "pnpm --filter api exec prisma migrate reset --force && pnpm db:seed",
    "db:seed": "pnpm --filter api exec prisma db seed",
    "db:studio": "pnpm --filter api exec prisma studio",
    "db:check": "pnpm --filter api exec prisma validate",
    "// — Docker / Infrastructure ——————": "",
    "docker:up": "docker-compose up -d",
    "docker:up:ocr": "docker-compose --profile ocr up -d",
    "docker:up:vlm": "docker-compose --profile vlm up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:dev": "docker-compose --env-file .env.dev up -d",
    "docker:sit": "docker-compose --env-file .env.sit -f docker-compose.yml -f docker-compose.sit.yml up -d",
    "docker:prod": "docker-compose --env-file .env.prod -f docker-compose.production.yml up -d --build",
    "docker:prod:down": "docker-compose -f docker-compose.production.yml down",
    "status": "docker-compose ps",
    "// — Utilities ————————————————————": "",
    "env:check": "node -e \"const e=process.env.APP_ENV||'local';const f='.env.'+e;require('fs').existsSync(f)?console.log('Using: '+f):console.error('Missing: '+f)\"",
    "generate:types": "pnpm --filter @mizano/shared-types build",
    "generate:validators": "pnpm --filter @mizano/validators build",
    "clean": "turbo clean && rm -rf node_modules .turbo",
    "clean:full": "turbo clean && rm -rf node_modules .turbo apps/web/.next apps/api/dist packages/*/dist coverage",
    "prepare": "husky"
  },
  "lint-staged": {
    "apps/api/**/*.ts": [
      "eslint --fix --cache",
      "prettier --write"
    ],
    "apps/web/**/*.{ts,tsx}": [
      "eslint --fix --cache",
      "prettier --write"
    ],
    "packages/**/*.ts": [
      "eslint --fix --cache",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@types/node": "^20.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.2.4",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "packageManager": "pnpm@8.14.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "pnpm": {
    "neverBuiltDependencies": [
      "gl"
    ]
  },
  "dependencies": {
    "@img/sharp-linux-x64": "^0.34.5"
  }
}
