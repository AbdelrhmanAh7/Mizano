# ============================================
# MIZANO ERP - SIT (System Integration Testing)
# ============================================
# Production-like environment for integration testing.
# Replace __CHANGE_ME__ placeholders before deployment.
#
# APP_ENV=sit  |  NODE_ENV=production
# ============================================

APP_ENV=sit

# ── Database ──────────────────────────────────────────────
POSTGRES_USER=mizano
POSTGRES_PASSWORD=__CHANGE_ME__
POSTGRES_DB=mizano_db
DATABASE_URL="postgresql://mizano:__CHANGE_ME__@postgres:5432/mizano_db?schema=public"

# ── Redis ─────────────────────────────────────────────────
REDIS_URL="redis://redis:6379"

# ── JWT Authentication ────────────────────────────────────
# Generate: openssl rand -base64 64
JWT_SECRET=__CHANGE_ME__
JWT_REFRESH_SECRET=__CHANGE_ME__
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ── NextAuth (Frontend Auth) ──────────────────────────────
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=__CHANGE_ME__
NEXTAUTH_URL=https://sit.yourdomain.com

# ── API Configuration ─────────────────────────────────────
API_PORT=6001
NODE_ENV=production
CORS_ORIGIN=https://sit.yourdomain.com

# ── Frontend ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://api-sit.yourdomain.com
NEXT_PUBLIC_APP_NAME=Mizano

# ── Rate Limiting ─────────────────────────────────────────
RATE_LIMIT_TTL=1000
RATE_LIMIT_MAX=60
RATE_LIMIT_AUTH_MAX=30

# ── Logging ───────────────────────────────────────────────
LOG_LEVEL=info

# ── OCR Service ───────────────────────────────────────────
OCR_SERVICE_URL=http://ocr-service:7001
OCR_SERVICE_TIMEOUT_MS=60000

# ── VLM Service ──────────────────────────────────────────
VLM_SERVICE_URL=http://vlm-service:8100
VLM_TIMEOUT_MS=120000
VLM_ENABLED=true
VLM_MODEL_NAME=Qwen/Qwen2.5-VL-7B-Instruct-AWQ

# ── SMTP / Email ─────────────────────────────────────────
SMTP_HOST=__CHANGE_ME__
SMTP_PORT=587
SMTP_USER=__CHANGE_ME__
SMTP_PASSWORD=__CHANGE_ME__
SMTP_FROM_EMAIL=noreply@sit.yourdomain.com
SMTP_FROM_NAME=Mizano ERP

# ── Monitoring (Optional) ────────────────────────────────
# SENTRY_DSN=__CHANGE_ME__
