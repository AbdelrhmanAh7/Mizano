# ============================================
# MIZANO ERP - Production Environment Variables
# ============================================
# Copy this file to .env.production and fill in the values

# ============================================
# DATABASE
# ============================================
POSTGRES_USER=mizano
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=mizano_db
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# ============================================
# REDIS
# ============================================
REDIS_URL=redis://redis:6379

# ============================================
# JWT AUTHENTICATION
# Generate secure secrets: openssl rand -base64 64
# ============================================
JWT_SECRET=your_jwt_secret_at_least_64_characters_long_random_string
JWT_REFRESH_SECRET=your_jwt_refresh_secret_at_least_64_characters_long_random_string
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ============================================
# NEXTAUTH (Frontend Auth)
# Generate secret: openssl rand -base64 32
# ============================================
NEXTAUTH_SECRET=your_nextauth_secret_at_least_32_characters
NEXTAUTH_URL=https://yourdomain.com

# ============================================
# API CONFIGURATION
# ============================================
NODE_ENV=production
API_PORT=6001
CORS_ORIGIN=https://yourdomain.com
NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# ============================================
# SMTP / EMAIL
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=Mizano ERP

# ============================================
# FILE STORAGE (Optional - for logos/attachments)
# ============================================
# AWS S3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=mizano-uploads
# AWS_S3_REGION=me-south-1

# Google Cloud Storage
# GCS_BUCKET=mizano-uploads
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ============================================
# MONITORING (Optional)
# ============================================
# SENTRY_DSN=https://xxx@sentry.io/xxx
# LOG_LEVEL=info

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_MAX=10

# ============================================
# SSL/TLS (for VPS deployment)
# ============================================
# SSL_CERT_PATH=/etc/letsencrypt/live/yourdomain.com/fullchain.pem
# SSL_KEY_PATH=/etc/letsencrypt/live/yourdomain.com/privkey.pem

# ============================================
# VLM Service (Local AI Invoice Processing)
# ============================================
# The VLM service runs Qwen2.5-VL locally on GPU for invoice data extraction
# Requires NVIDIA GPU with 12GB+ VRAM and NVIDIA Container Toolkit
VLM_SERVICE_URL=http://vlm-service:8100
VLM_TIMEOUT_MS=120000
VLM_ENABLED=true
VLM_MODEL_NAME=Qwen/Qwen2.5-VL-7B-Instruct-AWQ
