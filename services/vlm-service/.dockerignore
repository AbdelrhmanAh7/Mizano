# Virtual environments — never copy into the image
venv/
.venv/

# Python bytecode
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Distribution / packaging
*.egg-info/
dist/
build/
.eggs/

# Tests — not needed at runtime
tests/
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# Type checking caches
.mypy_cache/
.ruff_cache/

# HuggingFace model weights (mounted as a Docker volume, not baked into image)
models/
*.safetensors
*.bin
*.pt
*.pth

# Environment files (injected at runtime, never baked in)
.env
.env.*
!.env.example

# Git
.git
.gitignore

# IDE
.vscode/
.idea/
*.swp
*.swo

# Docs
README.md

# OS
.DS_Store
Thumbs.db
