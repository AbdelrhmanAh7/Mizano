    "bullmq": "^5.1.0",
    "cache-manager": "^7.2.8",
    "cache-manager-redis-yet": "^5.1.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.8.1",
    "compromise": "^14.14.5",
    "compromise-dates": "^3.7.1",
    "csv-parser": "^3.2.0",
