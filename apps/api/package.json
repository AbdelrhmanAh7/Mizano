    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "sentiment": "^5.0.2",
    "sharp": "^0.34.5",
    "simple-statistics": "^7.8.8",
    "socket.io": "^4.8.3",
    "tesseract.js": "^7.0.0",
    "uuid": "^9.0.0",
    "xlsx": "^0.18.5"
