model BOMItem {
  id       String  @id @default(cuid())
  bomId    String
  itemId   String
  quantity Decimal @db.Decimal(19, 4)

  // Relations
  bom  BOM  @relation(fields: [bomId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemId], references: [id])

