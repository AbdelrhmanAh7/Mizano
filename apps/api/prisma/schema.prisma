// ============================================
// LEAD SCORING
// ============================================

model LeadScore {
  id                    String    @id @default(cuid())
  leadId                String    @unique
  totalScore            Int       @default(0)
  demographicScore      Int       @default(0)
  behavioralScore       Int       @default(0)
  engagementScore       Int       @default(0)
  tier                  LeadTier  @default(COLD)
  conversionProbability Decimal   @default(0) @db.Decimal(5, 4)
  lastActivityAt        DateTime?
  lastScoredAt          DateTime  @default(now())
  scoreHistory          Json      @default("[]")
  organizationId        String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id])

  @@index([organizationId])
  @@index([organizationId, tier])
  @@index([organizationId, totalScore])
  @@map("lead_scores")
}

// ============================================
// PATTERN DETECTION
// ============================================

model TransactionPattern {
  id                 String              @id @default(cuid())
  entityType         String // 'vendor', 'customer', 'account'
  entityId           String?
  entityName         String // Normalized name for clustering
  amountCluster      Decimal             @db.Decimal(19, 4)
  amountVariance     Decimal             @default(0.01) @db.Decimal(5, 4)
  frequency          RecurringFrequency?
  frequencyDays      Int?
  frequencyStdDev    Decimal?            @db.Decimal(10, 2)
  occurrenceCount    Int                 @default(0)
  firstOccurrence    DateTime
  lastOccurrence     DateTime
  descriptionPattern String?
  descriptionHash    String?
  confidence         Decimal             @default(0) @db.Decimal(5, 4)
  status             PatternStatus       @default(DETECTED)
  organizationId     String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  // Relations
  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  occurrences  PatternOccurrence[]
  suggestions  PatternSuggestion[]

  @@unique([organizationId, entityName, amountCluster])
  @@index([organizationId])
  @@index([organizationId, status])
  @@map("transaction_patterns")
}

model PatternOccurrence {
  id             String   @id @default(cuid())
  patternId      String
  sourceType     String // 'journal', 'expense', 'bank_transaction'
  sourceId       String
  amount         Decimal  @db.Decimal(19, 4)
  date           DateTime
  description    String?
  organizationId String
  createdAt      DateTime @default(now())

  // Relations
  pattern TransactionPattern @relation(fields: [patternId], references: [id], onDelete: Cascade)

  @@index([patternId])
  @@index([organizationId, date])
  @@map("pattern_occurrences")
}

model PatternSuggestion {
  id                 String              @id @default(cuid())
  patternId          String
  suggestionType     SuggestionType
  suggestedFrequency RecurringFrequency?
  suggestedAmount    Decimal             @db.Decimal(19, 4)
  suggestedEntityId  String?
  confidence         Decimal             @db.Decimal(5, 4)
  status             SuggestionStatus    @default(PENDING)
  recurringProfileId String?
  dismissedAt        DateTime?
  dismissedReason    String?
  organizationId     String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  // Relations
  pattern TransactionPattern @relation(fields: [patternId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("pattern_suggestions")
}

// ============================================
// FIXED ASSETS
// ============================================

model Asset {
  id                       String             @id @default(cuid())
  assetNumber              String // FA-001 auto-increment
  name                     String
  description              String?
  assetType                AssetType
  purchaseDate             DateTime
  purchasePrice            Decimal            @db.Decimal(19, 4)
  salvageValue             Decimal            @db.Decimal(19, 4)
  usefulLifeYears          Int
  depreciationMethod       DepreciationMethod @default(STRAIGHT_LINE)
  monthlyDepreciation      Decimal            @db.Decimal(19, 4)
  accumulatedDepreciation  Decimal            @default(0) @db.Decimal(19, 4)
  currentBookValue         Decimal            @db.Decimal(19, 4)
  status                   AssetStatus        @default(ACTIVE)
  disposalDate             DateTime?
  disposalAmount           Decimal?           @db.Decimal(19, 4)
  disposalGainLoss         Decimal?           @db.Decimal(19, 4)
  assetAccountId           String
  depreciationAccountId    String
  accumulatedDeprAccountId String
  organizationId           String
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  deletedAt                DateTime?

  // Relations
  organization           Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assetAccount           Account                @relation("AssetAccount", fields: [assetAccountId], references: [id])
  depreciationAccount    Account                @relation("DepreciationAccount", fields: [depreciationAccountId], references: [id])
  accumulatedDeprAccount Account                @relation("AccumulatedDeprAccount", fields: [accumulatedDeprAccountId], references: [id])
  depreciationSchedule      DepreciationSchedule[]
  maintenancePredictions    AssetMaintenancePrediction[]

  @@unique([organizationId, assetNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@map("assets")
}

model DepreciationSchedule {
  id               String    @id @default(cuid())
  assetId          String
  month            Int
  year             Int
  amount           Decimal   @db.Decimal(19, 4)
  accumulatedTotal Decimal   @db.Decimal(19, 4)
  bookValue        Decimal   @db.Decimal(19, 4)
  journalId        String?
  executedAt       DateTime?
  organizationId   String

  // Relations
  asset        Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  journal      Journal?     @relation(fields: [journalId], references: [id])
  Organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([assetId, month, year])
  @@index([organizationId, year, month])
  @@map("depreciation_schedules")
}

// ============================================
// CRM - LEADS & DEALS
// ============================================

model Lead {
  id                    String     @id @default(cuid())
  leadName              String
  companyName           String?
  email                 String?
  phone                 String?
  source                LeadSource
  status                LeadStatus @default(NEW)
  assignedToId          String?
  notes                 String?
  customFields          Json?
  convertedToCustomerId String?
  convertedAt           DateTime?
  organizationId        String
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  deletedAt             DateTime?

  // Relations
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTo   User?         @relation("LeadAssignee", fields: [assignedToId], references: [id])
  activities   ActivityLog[]
  deals        Deal[]
  score        LeadScore?

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, source])
  @@map("leads")
}

model Deal {
  id                String    @id @default(cuid())
  dealName          String
  leadId            String?
  customerId        String?
  stage             DealStage @default(NEW)
  expectedAmount    Decimal   @db.Decimal(19, 4)
  probability       Int       @default(0)
  expectedCloseDate DateTime?
  actualCloseDate   DateTime?
  assignedToId      String?
  lostReason        String?
  wonQuoteId        String?
  organizationId    String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  // Relations
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead?         @relation(fields: [leadId], references: [id])
  customer     Customer?     @relation(fields: [customerId], references: [id])
  assignedTo   User?         @relation("DealAssignee", fields: [assignedToId], references: [id])
  activities   ActivityLog[]
  wonQuote     Quote?        @relation(fields: [wonQuoteId], references: [id])

  @@index([organizationId])
  @@index([organizationId, stage])
  @@map("deals")
}

model ActivityLog {
  id             String       @id @default(cuid())
  leadId         String?
  dealId         String?
  type           ActivityType
  description    String
  date           DateTime     @default(now())
  userId         String
  organizationId String
  createdAt      DateTime     @default(now())

  // Relations
  lead         Lead?        @relation(fields: [leadId], references: [id])
  deal         Deal?        @relation(fields: [dealId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  Organization Organization @relation(fields: [organizationId], references: [id])

  @@index([leadId])
  @@index([dealId])
  @@index([organizationId])
  @@map("activity_logs")
}

// ============================================
// DELIVERY CHALLANS
// ============================================

model DeliveryChallan {
  id             String        @id @default(cuid())
  challanNumber  String // DC-001 auto-increment
  customerId     String
  invoiceId      String?
  challanType    ChallanType
  date           DateTime
  status         ChallanStatus @default(DRAFT)
  notes          String?
  organizationId String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  // Relations
  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer              @relation(fields: [customerId], references: [id])
  invoice      Invoice?              @relation(fields: [invoiceId], references: [id])
  lines        DeliveryChallanLine[]

  @@unique([organizationId, challanNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@map("delivery_challans")
}

model DeliveryChallanLine {
  id          String  @id @default(cuid())
  challanId   String
  itemId      String
  quantity    Decimal @db.Decimal(19, 4)
  description String?
  warehouseId String?

  // Relations
  challan   DeliveryChallan @relation(fields: [challanId], references: [id], onDelete: Cascade)
  item      Item            @relation(fields: [itemId], references: [id])
  warehouse Warehouse?      @relation(fields: [warehouseId], references: [id])

  @@map("delivery_challan_lines")
}

// ============================================
// EXCHANGE RATES (MULTI-CURRENCY)
// ============================================

model ExchangeRate {
  id             String   @id @default(cuid())
  fromCurrency   String // ISO code: USD, SAR, EUR
  toCurrency     String
  rate           Decimal  @db.Decimal(19, 6)
  date           DateTime
  source         String   @default("MANUAL") // MANUAL, AUTO
  organizationId String
  createdAt      DateTime @default(now())

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, fromCurrency, toCurrency, date])
  @@index([organizationId, date])
  @@map("exchange_rates")
}

// ============================================
// EMAIL LOG
// ============================================

model EmailLog {
  id             String   @id @default(cuid())
  to             String
  subject        String
  entityType     String // 'invoice', 'quote', 'payslip'
  entityId       String
  sentAt         DateTime @default(now())
  status         String // 'sent', 'failed', 'bounced'
  error          String?
  organizationId String
  createdAt      DateTime @default(now())

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, entityType, entityId])
  @@map("email_logs")
}

// ============================================
// RECURRING EXECUTIONS
// ============================================

model RecurringExecution {
  id                String   @id @default(cuid())
  profileId         String
  executedAt        DateTime @default(now())
  createdEntityType String // 'journal', 'invoice', 'bill', 'expense'
  createdEntityId   String
  status            String // 'success', 'failed'
  error             String?
  organizationId    String

  // Relations
  profile RecurringProfile @relation(fields: [profileId], references: [id])

  @@index([profileId])
  @@index([organizationId])
  @@map("recurring_executions")
}

// ============================================
// ORGANIZATION ONBOARDING
// ============================================

model OrganizationOnboarding {
  id             String @id @default(cuid())
  organizationId String @unique

  // Step Completion Tracking
  companyInfoCompleted     Boolean @default(false)
  chartOfAccountsCompleted Boolean @default(false)
  taxConfigCompleted       Boolean @default(false)
  openingBalancesCompleted Boolean @default(false)
  importDataCompleted      Boolean @default(false)
  aiFeaturesCompleted      Boolean @default(false)
  tourCompleted            Boolean @default(false)

  // Step Data Storage
  selectedIndustry    String?
  selectedCoaTemplate String?
  skippedSteps        String[] // Array of skipped step names
  completedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_onboarding")
}

// ============================================
// AI - CUSTOMER AI PROFILE (Churn, CLV, Cross-sell)
// ============================================

model CustomerAiProfile {
  id               String    @id @default(cuid())
  customerId       String    @unique
  churnRisk        Decimal   @default(0) @db.Decimal(5, 4)
  churnFactors     Json      @default("[]")
  lifetimeValue    Decimal   @default(0) @db.Decimal(19, 4)
  clvSegment       String?
  rfmRecency       Int?
  rfmFrequency     Int?
  rfmMonetary      Decimal?  @db.Decimal(19, 4)
  lastPurchaseDate DateTime?
  crossSellItems   Json      @default("[]")
  upsellItems      Json      @default("[]")
  organizationId   String
  calculatedAt     DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, churnRisk])
  @@map("customer_ai_profiles")
}

// ============================================
// AI - EMPLOYEE AI PROFILE (Attrition, Compensation, Skills)
// ============================================

model EmployeeAiProfile {
  id                String    @id @default(cuid())
  employeeId        String    @unique
  attritionRisk     Decimal   @default(0) @db.Decimal(5, 4)
  attritionFactors  Json      @default("[]")
  compensationIndex Decimal?  @db.Decimal(5, 4)
  skillsProfile     Json      @default("{}")
  skillsGaps        Json      @default("[]")
  organizationId    String
  calculatedAt      DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, attritionRisk])
  @@map("employee_ai_profiles")
}

// ============================================
// AI - FRAUD ALERTS
// ============================================

model FraudAlert {
  id               String    @id @default(cuid())
  entityType       String
  entityId         String
  fraudScore       Decimal   @db.Decimal(5, 4)
  signals          Json      @default("[]")
  velocityCheck    Boolean   @default(false)
  amountAnomaly    Boolean   @default(false)
  timeAnomaly      Boolean   @default(false)
  duplicateCheck   Boolean   @default(false)
  isConfirmedFraud Boolean   @default(false)
  isResolved       Boolean   @default(false)
  resolvedAt       DateTime?
  resolvedBy       String?
  organizationId   String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, isResolved])
  @@index([entityType, entityId])
  @@map("fraud_alerts")
}

// ============================================
// AI - ASSET MAINTENANCE PREDICTIONS
// ============================================

model AssetMaintenancePrediction {
  id                   String    @id @default(cuid())
  assetId              String
  predictedFailureDate DateTime?
  riskScore            Decimal   @db.Decimal(5, 4)
  healthScore          Decimal   @db.Decimal(5, 4)
  factors              Json      @default("[]")
  recommendedAction    String?
  organizationId       String
  calculatedAt         DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  asset        Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([assetId])
  @@map("asset_maintenance_predictions")
}

// ============================================
// DEEP SEARCH AGENT
// ============================================

model DeepSearchJob {
  id                String           @id @default(cuid())
  status            DeepSearchStatus @default(PENDING)
  progress          Int              @default(0)
  progressMessage   String?
  webSourcesScraped Int              @default(0)
  codeFilesAnalyzed Int              @default(0)
  suggestionsCount  Int              @default(0)
  error             String?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  suggestions    DeepSearchSuggestion[]

  @@index([organizationId, createdAt])
  @@map("deep_search_jobs")
}

model DeepSearchSuggestion {
  id          String             @id @default(cuid())
  category    SuggestionCategory
  title       String
  description String             @db.Text
  impact      String
  effort      String
  priority    Int
  tags        String[]
  sources     Json?
  prompt      String             @db.Text
  status      String             @default("pending")
  createdAt   DateTime           @default(now())

  job            DeepSearchJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId          String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  @@index([jobId])
  @@index([organizationId, category])
  @@map("deep_search_suggestions")
}

// ============================================
// SEARCH HISTORY
// ============================================

model SearchHistory {
  id          String   @id @default(cuid())
  query       String
  resultType  String?  // Entity type: customer, invoice, item, etc.
  resultId    String?  // ID of the clicked result
  resultTitle String?  // Display title of the clicked result
  clickedAt   DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  @@unique([organizationId, userId, query])
  @@index([organizationId, userId, clickedAt])
  @@map("search_histories")
}

// ============================================
// DOCUMENT SEQUENCE
// ============================================

model DocumentSequence {
  id             String       @id @default(cuid())
  prefix         String       // INV, BILL, JRN, QT, CN, PMT, VPMT, ADJ, WO, DC, VC, AST
  nextNumber     Int          @default(1)
  padLength      Int          @default(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, prefix])
  @@map("document_sequences")
}
