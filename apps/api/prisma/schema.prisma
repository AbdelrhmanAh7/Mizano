// ============================================
// MIZANO ERP - Prisma Schema
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  INCOME
  EXPENSE
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  INVOICED
  DECLINED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum BillStatus {
  DRAFT
  PENDING
  OPEN
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum ExpenseStatus {
  DRAFT
  PENDING
  POSTED
  RECORDED
  PAID
  CANCELLED
}

enum PaymentMode {
  CASH
  BANK_TRANSFER
  CREDIT_CARD
  DEBIT_CARD
  CHEQUE
  ONLINE
  OTHER
}

enum ItemType {
  GOODS
  SERVICE
  DIGITAL
}

enum AdjustmentType {
  INCREASE
  DECREASE
}

enum AdjustmentReason {
  DAMAGED
  STOLEN
  STOCKTAKE
  RETURNED
  EXPIRED
  OTHER
}

enum TransferStatus {
  PENDING
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum BankAccountType {
  BANK
  CREDIT_CARD
  PETTY_CASH
}

enum BankTransactionType {
  DEPOSIT
  WITHDRAWAL
}

enum ReconciliationStatus {
  PENDING
  MATCHED
  CREATED
  RECONCILED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
  HALF_DAY
}

enum PayrollStatus {
  DRAFT
  PROCESSED
  PAID
}

enum WorkOrderStatus {
  DRAFT
  IN_PROCESS
  COMPLETED
  CANCELLED
}

enum BillingMethod {
  FIXED
  HOURLY
  PROJECT_HOURLY
  TASK_HOURLY
  STAFF_HOURLY
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TimesheetStatus {
  UNBILLED
  INVOICED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum VATReturnStatus {
  DRAFT
  CALCULATED
  GENERATED
  SUBMITTED
  FILED
}

enum TaxType {
  SALES
  PURCHASES
  BOTH
}

enum RecurringFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  JUNK
  WON
  LOST
}

enum LeadSource {
  WEBSITE
  FACEBOOK_ADS
  GOOGLE_ADS
  REFERRAL
  COLD_CALL
  OTHER
}

enum DealStage {
  NEW
  MEETING_SCHEDULED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

enum DepreciationMethod {
  STRAIGHT_LINE
  DECLINING_BALANCE
}

enum AssetStatus {
  ACTIVE
  DISPOSED
  SOLD
  FULLY_DEPRECIATED
}

enum CreditNoteType {
  REFUND
  APPLY_TO_INVOICE
}

enum PriceListType {
  PERCENTAGE
  FIXED
}

// ============================================
// AI INFRASTRUCTURE ENUMS
// ============================================

enum AiFeature {
  // Core Financial AI (10)
  CATEGORIZATION
  RECONCILIATION

  DEMAND_FORECAST
  LEAD_SCORING
  ANOMALY
  REORDER
  PAYMENT_PREDICTION
  CASH_FLOW
  PATTERN_DETECTION
  // Sales & CRM AI (5)
  CHURN_PREDICTION
  CLV_ANALYSIS
  CROSS_SELL
  DYNAMIC_PRICING
  PIPELINE_FORECAST
  // Security & Compliance AI (3)
  FRAUD_DETECTION
  COMPLIANCE_MONITORING
  AUDIT_RISK
  // NLP AI (4)
  DOCUMENT_CLASSIFICATION
  SENTIMENT_ANALYSIS
  ENTITY_EXTRACTION
  CONTRACT_ANALYSIS
  // HR AI (3)
  EMPLOYEE_ATTRITION
  COMPENSATION_BENCHMARK
  SKILLS_GAP
  // Operations AI (5)
  QUALITY_PREDICTION
  PREDICTIVE_MAINTENANCE
  WORKFORCE_SCHEDULING
  ROUTE_OPTIMIZATION
  RESOURCE_OPTIMIZATION
  // Conversational & Voice AI (3)
  CHATBOT
  KNOWLEDGE_ASSISTANT
  VOICE_COMMAND
}

enum LeadTier {
  HOT
  WARM
  COOL
  COLD
}

enum AiFeedbackAction {
  ACCEPTED
  REJECTED
  CORRECTED
}

enum AnomalyType {
  TRANSACTION
  OVERTIME
  SPENDING
  PAYROLL
  INVENTORY
  REVENUE
}

enum AnomalySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ReorderStatus {
  OK
  LOW_STOCK
  CRITICAL
  DEAD_STOCK
}

// Pattern Detection Enums
enum PatternStatus {
  DETECTED
  CONFIRMED
  CONVERTED
  DISMISSED
  STALE
}

enum SuggestionType {
  CREATE_RECURRING
  DUPLICATE_WARNING
  FREQUENCY_CHANGE
}

enum SuggestionStatus {
  PENDING
  ACCEPTED
  DISMISSED
}

// Alert Engine Enums
enum AlertCategory {
  FINANCIAL
  COLLECTION
  INVENTORY
  COMPLIANCE
  HR
  CRM
}

enum AlertPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum AlertSource {
  CASH_FLOW
  ANOMALY
  PAYMENT_PREDICTION
  REORDER
  DEMAND_FORECAST
  LEAD_SCORING
  PATTERN_DETECTION
  TAX_COMPLIANCE
  PAYROLL
}

// Fixed Assets Enums
enum AssetType {
  ELECTRONICS
  FURNITURE
  VEHICLES
  MACHINERY
  BUILDINGS
  OTHER
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
  TASK
}

// Delivery Challan Enums
enum ChallanType {
  SUPPLY
  JOB_WORK
  SAMPLE
}

enum ChallanStatus {
  DRAFT
  ISSUED
  RETURNED
}

// Recurring Profile Type
enum RecurringType {
  JOURNAL
  INVOICE
  BILL
  EXPENSE
}

enum DeepSearchStatus {
  PENDING
  SCRAPING
  ANALYZING
  GENERATING
  COMPLETED
  FAILED
}

enum SuggestionCategory {
  FEATURE_GAP
  PERFORMANCE_UX
  AI_CAPABILITY
}

// ============================================
// ORGANIZATION & AUTH
// ============================================

model Organization {
  id        String    @id @default(cuid())
  name      String
  email     String?
  phone     String?
  address   String?
  city      String?
  country   String?
  currency  String    @default("USD")
  taxId     String?
  lockDate  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Default account settings for accounting entries
  defaultArAccountId            String? // Accounts Receivable
  defaultRevenueAccountId       String? // Sales Revenue
  defaultVatPayableAccountId    String? // VAT Payable (Sales)
  defaultApAccountId            String? // Accounts Payable
  defaultVatReceivableAccountId String? // VAT Receivable (Purchases)
  defaultBankAccountId          String? // Default Bank Account
  defaultCashAccountId          String? // Default Cash Account
  defaultSalesReturnsAccountId  String? // Sales Returns / Credit Notes

  // Relations
  users                 User[]
  roles                 Role[]
  accounts              Account[]
  journals              Journal[]
  recurringProfiles     RecurringProfile[]
  customers             Customer[]
  quotes                Quote[]
  invoices              Invoice[]
  creditNotes           CreditNote[]
  paymentsReceived      PaymentReceived[]
  vendors               Vendor[]
  expenses              Expense[]
  bills                 Bill[]
  vendorCredits         VendorCredit[]
  paymentsMade          PaymentMade[]
  items                 Item[]
  compositeItems        CompositeItem[]
  warehouses            Warehouse[]
  inventoryMovements    InventoryMovement[]
  inventoryAdjustments  InventoryAdjustment[]
  inventoryLevels       InventoryLevel[]
  inventoryCostLayers   InventoryCostLayer[]
  inventoryTransfers    InventoryTransfer[]
  priceLists            PriceList[]
  bankAccounts          BankAccount[]
  bankTransactions      BankTransaction[]
  bankRules             BankRule[]
  employees             Employee[]
  attendances           Attendance[]
  payrollRuns           PayrollRun[]
  boms                  BOM[]
  workOrders            WorkOrder[]
  projects              Project[]
  tasks                 Task[]
  timesheetEntries      TimesheetEntry[]
  taxRates              TaxRate[]
  vatReturns            VATReturn[]
  vatPayments           VATPayment[]
  assets                Asset[]
  leads                 Lead[]
  deals                 Deal[]
  auditLogs             AuditLog[]
  aiInsights            AIInsight[]
  notifications         Notification[]
  depreciationSchedules DepreciationSchedule[]
  productionEntries     ProductionEntry[]
  reconciliations       Reconciliation[]

  // AI Infrastructure Relations
  aiFeedback             AiFeedback[]
  aiPredictions          AiPrediction[]
  aiAnomalies            AiAnomaly[]
  itemReorderAnalysis    ItemReorderAnalysis[]
  reconciliationPatterns ReconciliationPattern[]

  itemDemandForecasts    ItemDemandForecast[]
  cashFlowForecasts      CashFlowForecast[]
  leadScores             LeadScore[]

  // New AI & Module Relations
  transactionPatterns            TransactionPattern[]
  customerAiProfiles             CustomerAiProfile[]
  employeeAiProfiles             EmployeeAiProfile[]
  fraudAlerts                    FraudAlert[]
  assetMaintenancePredictions    AssetMaintenancePrediction[]
  deepSearchJobs                 DeepSearchJob[]
  deepSearchSuggestions          DeepSearchSuggestion[]
  searchHistories                SearchHistory[]
  documentSequences              DocumentSequence[]
  deliveryChallans               DeliveryChallan[]
  exchangeRates       ExchangeRate[]
  emailLogs           EmailLog[]
  activityLogs        ActivityLog[]

  // Organization settings for PDF/Email
  logoUrl        String?
  primaryColor   String? @default("#3B82F6")
  companyAddress String?
  bankDetails    String?
  footerText     String?
  smtpHost       String?
  smtpPort       Int?
  smtpUser       String?
  smtpPassword   String?
  smtpFromEmail  String?
  smtpFromName   String?
  baseCurrency   String  @default("SAR")

  // General Settings
  website               String?
  taxRegistrationNumber String?
  industry              String? @default("other")

  // Financial Settings
  fiscalYearStartMonth    Int     @default(1) // 1 = January
  defaultPaymentTermsDays Int     @default(30)
  defaultTaxRateId        String?

  // Invoice Settings
  invoicePrefix       String  @default("INV-")
  invoiceNextNumber   Int     @default(1)
  invoiceDefaultNotes String?
  invoiceDefaultTerms String?
  invoiceAutoSend     Boolean @default(false)
  quotePrefix         String  @default("QT-")
  quoteNextNumber     Int     @default(1)
  billPrefix          String  @default("BILL-")
  billNextNumber      Int     @default(1)

  // Inventory Settings
  defaultValuationMethod String  @default("FIFO") // FIFO, LIFO, WEIGHTED_AVG
  enableMultiWarehouse   Boolean @default(false)
  enableBundles          Boolean @default(false)

  // AI Settings
  aiCategorizationEnabled Boolean @default(true)
  aiReconciliationEnabled Boolean @default(true)

  aiForecastingEnabled    Boolean @default(true)
  aiAnomalyEnabled        Boolean @default(true)
  aiLeadScoringEnabled    Boolean @default(true)
  anomalySensitivity      Int     @default(3) // Z-score threshold (2-4)

  // Localization Settings
  dateFormat   String @default("DD/MM/YYYY")
  numberFormat String @default("1,000.00") // or "1.000,00"
  timezone     String @default("Asia/Riyadh")

  // Onboarding
  onboardingCompleted Boolean                 @default(false)
  onboarding          OrganizationOnboarding?

  @@map("organizations")
}

model User {
  id             String     @id @default(cuid())
  email          String
  passwordHash   String
  name           String
  firstName      String?
  lastName       String?
  status         UserStatus @default(ACTIVE)
  refreshToken   String?
  roleId         String
  organizationId String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  // Relations
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role             Role             @relation(fields: [roleId], references: [id])
  preferences      UserPreferences?
  timesheetEntries TimesheetEntry[]
  auditLogs        AuditLog[]
  notifications    Notification[]
  assignedLeads    Lead[]           @relation("LeadAssignee")
  assignedDeals    Deal[]           @relation("DealAssignee")
  assignedTasks    Task[]           @relation("AssignedTasks")
  activityLogs     ActivityLog[]
  searchHistories  SearchHistory[]

  @@unique([email, organizationId])
  @@index([organizationId])
  @@index([email])
  @@map("users")
}

model UserPreferences {
  id     String @id @default(cuid())
  userId String @unique

  // Tour Progress Tracking
  tourProgress   Json?     // { "sales_invoices": { completed: true, step: 5, completedAt: "..." }, ... }
  tourDismissed  String[]  // Array of dismissed tour IDs
  lastTourSeenAt DateTime?

  // UI Preferences (future-proofing)
  theme             String?  @default("light")
  sidebarCollapsed  Boolean  @default(false)
  dashboardLayout   Json?
  notificationPrefs Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model Role {
  id             String   @id @default(cuid())
  name           String
  description    String?
  isDefault      Boolean  @default(false)
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  Permission[]
  users        User[]

  @@unique([name, organizationId])
  @@index([organizationId])
  @@map("roles")
}

model Permission {
  id      String   @id @default(cuid())
  roleId  String
  module  String
  actions String[] // Array of: view, create, edit, delete, export

  // Relations
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, module])
  @@map("permissions")
}

// ============================================
// CHART OF ACCOUNTS & JOURNALS
// ============================================

model Account {
  id             String      @id @default(cuid())
  code           String
  name           String
  type           AccountType
  subType        String?
  parentId       String?
  currency       String      @default("USD")
  description    String?
  openingBalance Decimal?    @default(0) @db.Decimal(19, 4)
  isActive       Boolean     @default(true)
  isSystem       Boolean     @default(false)
  organizationId String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?

  // Relations
  organization            Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent                  Account?              @relation("AccountHierarchy", fields: [parentId], references: [id])
  children                Account[]             @relation("AccountHierarchy")
  journalLines            JournalLine[]
  expenses                Expense[]             @relation("ExpenseAccount")
  expensesPaidThrough     Expense[]             @relation("ExpensePaidThrough")
  billLines               BillLine[]
  salesItems              Item[]                @relation("SalesAccount")
  purchaseItems           Item[]                @relation("PurchaseAccount")
  inventoryItems          Item[]                @relation("InventoryAccount")
  bankAccounts            BankAccount[]
  taxRatesLinked          TaxRate[]             @relation("TaxRateLinkedAccount")
  taxRatesCollect         TaxRate[]             @relation("TaxRateCollectAccount")
  adjustments             InventoryAdjustment[]
  assetAccounts           Asset[]               @relation("AssetAccount")
  depreciationAccounts    Asset[]               @relation("DepreciationAccount")
  accumulatedDeprAccounts Asset[]               @relation("AccumulatedDeprAccount")

  @@unique([code, organizationId])
  @@index([organizationId])
  @@index([type])
  @@index([organizationId, type, isActive])
  @@map("accounts")
}

model Journal {
  id             String    @id @default(cuid())
  journalNumber  String
  date           DateTime
  reference      String?
  notes          String?
  isPosted       Boolean   @default(true)
  reversalOfId   String?   @unique
  // Business event that produced this journal (e.g. BILL_APPROVAL + billId).
  // Unique per organization so a retried/concurrent command posts at most once.
  sourceType     String?
  sourceId       String?
  organizationId String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  // Relations
  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lines                 JournalLine[]
  depreciationSchedules DepreciationSchedule[]
  reversalOf            Journal?               @relation("JournalReversal", fields: [reversalOfId], references: [id])
  reversedBy            Journal?               @relation("JournalReversal")
  payrollRun            PayrollRun?
  workOrder             WorkOrder?

  @@unique([journalNumber, organizationId])
  @@unique([organizationId, sourceType, sourceId])
  @@index([organizationId])
  @@index([date])
  @@index([organizationId, deletedAt, date])
  @@index([organizationId, isPosted, date])
  @@map("journals")
}

model JournalLine {
  id          String  @id @default(cuid())
  journalId   String
  accountId   String
  debit       Decimal @default(0) @db.Decimal(19, 4)
  credit      Decimal @default(0) @db.Decimal(19, 4)
  description String?

  // Relations
  journal Journal @relation(fields: [journalId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id])

  @@index([journalId])
  @@index([accountId])
  @@index([accountId, journalId])
  @@map("journal_lines")
}

model RecurringProfile {
  id             String             @id @default(cuid())
  name           String
  type           RecurringType? // journal, invoice, bill, expense
  frequency      RecurringFrequency
  startDate      DateTime
  endDate        DateTime?
  nextRunDate    DateTime
  isActive       Boolean            @default(true)
  autoPost       Boolean            @default(false)
  autoSend       Boolean            @default(false) // For invoices
  templateData   Json
  entityType     String // Deprecated: use 'type' instead
  executionCount Int                @default(0)
  lastExecutedAt DateTime?
  organizationId String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?

  // Relations
  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  executions   RecurringExecution[]

  @@index([organizationId])
  @@index([nextRunDate])
  @@map("recurring_profiles")
}

// ============================================
// CUSTOMERS & SALES
// ============================================

model Customer {
  id                 String    @id @default(cuid())
  name               String
  displayName        String?
  email              String?
  phone              String?
  currency           String    @default("USD")
  taxId              String?
  // Simple address fields for import/export
  address            String?
  city               String?
  country            String?
  creditLimit        Decimal?  @db.Decimal(19, 4)
  // Detailed billing address
  billingStreet      String?
  billingCity        String?
  billingState       String?
  billingPostalCode  String?
  billingCountry     String?
  shippingStreet     String?
  shippingCity       String?
  shippingState      String?
  shippingPostalCode String?
  shippingCountry    String?
  paymentTerms       Int       @default(0)
  priceListId        String?
  organizationId     String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  // Relations
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  priceList        PriceList?        @relation(fields: [priceListId], references: [id])
  quotes           Quote[]
  invoices         Invoice[]
  creditNotes      CreditNote[]
  paymentsReceived PaymentReceived[]
  projects         Project[]
  deals            Deal[]
  deliveryChallans DeliveryChallan[]
  aiProfile        CustomerAiProfile?

  @@index([organizationId])
  @@index([name])
  @@map("customers")
}

model Quote {
  id             String      @id @default(cuid())
  quoteNumber    String
  customerId     String
  date           DateTime
  expiryDate     DateTime
  status         QuoteStatus @default(DRAFT)
  subtotal       Decimal     @default(0) @db.Decimal(19, 4)
  taxAmount      Decimal     @default(0) @db.Decimal(19, 4)
  discountAmount Decimal     @default(0) @db.Decimal(19, 4)
  discount       Decimal     @default(0) @db.Decimal(19, 4)
  grandTotal     Decimal     @default(0) @db.Decimal(19, 4)
  currencyCode   String?
  notes          String?
  terms          String?
  organizationId String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id])
  lines        QuoteLine[]
  invoices     Invoice[]
  wonDeals     Deal[]

  @@unique([quoteNumber, organizationId])
  @@index([organizationId])
  @@index([customerId])
  @@index([status])
  @@index([organizationId, deletedAt, status])
  @@map("quotes")
}

model QuoteLine {
  id          String  @id @default(cuid())
  quoteId     String
  itemId      String?
  description String
  quantity    Decimal @db.Decimal(19, 4)
  rate        Decimal @db.Decimal(19, 4)
  discount    Decimal @default(0) @db.Decimal(19, 4)
  taxRate     Decimal @default(0) @db.Decimal(5, 2)
  amount      Decimal @default(0) @db.Decimal(19, 4)

  // Relations
  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  item  Item? @relation(fields: [itemId], references: [id])

  @@index([quoteId])
  @@map("quote_lines")
}

model Invoice {
  id             String        @id @default(cuid())
  invoiceNumber  String
  customerId     String
  quoteId        String?
  projectId      String?
  date           DateTime
  issueDate      DateTime?
  dueDate        DateTime
  status         InvoiceStatus @default(DRAFT)
  subtotal       Decimal       @default(0) @db.Decimal(19, 4)
  taxAmount      Decimal       @default(0) @db.Decimal(19, 4)
  discountAmount Decimal       @default(0) @db.Decimal(19, 4)
  shippingAmount Decimal       @default(0) @db.Decimal(19, 4)
  grandTotal     Decimal       @default(0) @db.Decimal(19, 4)
  total          Decimal?      @db.Decimal(19, 4)
  balanceDue     Decimal       @default(0) @db.Decimal(19, 4)
  currencyCode   String?
  exchangeRate   Decimal?      @db.Decimal(19, 6)
  notes          String?
  terms          String?
  organizationId String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  // Relations
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer           Customer            @relation(fields: [customerId], references: [id])
  quote              Quote?              @relation(fields: [quoteId], references: [id])
  project            Project?            @relation(fields: [projectId], references: [id])
  lines              InvoiceLine[]
  creditNotes        CreditNote[]
  paymentAllocations PaymentAllocation[]
  timesheetEntries   TimesheetEntry[]
  appliedCredits     CreditNote[]        @relation("AppliedCredits")
  deliveryChallans   DeliveryChallan[]

  @@unique([invoiceNumber, organizationId])
  @@index([organizationId])
  @@index([customerId])
  @@index([status])
  @@index([dueDate])
  @@index([organizationId, status])
  @@index([organizationId, customerId])
  @@index([organizationId, dueDate])
  @@index([organizationId, deletedAt, status, date])
  @@index([organizationId, deletedAt, balanceDue])
  @@map("invoices")
}

model InvoiceLine {
  id          String   @id @default(cuid())
  invoiceId   String
  itemId      String?
  taxRateId   String?
  description String
  quantity    Decimal  @db.Decimal(19, 4)
  rate        Decimal  @db.Decimal(19, 4)
  unitPrice   Decimal? @db.Decimal(19, 4)
  discount    Decimal  @default(0) @db.Decimal(19, 4)
  taxRate     Decimal  @default(0) @db.Decimal(5, 2)
  amount      Decimal  @default(0) @db.Decimal(19, 4)
  sortOrder   Int      @default(0)

  // Relations
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  item    Item?   @relation(fields: [itemId], references: [id])

  @@index([invoiceId])
  @@map("invoice_lines")
}

model CreditNote {
  id                 String         @id @default(cuid())
  creditNoteNumber   String
  customerId         String
  invoiceId          String
  date               DateTime
  issueDate          DateTime?
  reason             String
  amount             Decimal        @db.Decimal(19, 4)
  total              Decimal?       @db.Decimal(19, 4)
  type               CreditNoteType
  appliedToInvoiceId String?
  refundedAt         DateTime?
  organizationId     String
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  deletedAt          DateTime?

  // Relations
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer         Customer     @relation(fields: [customerId], references: [id])
  invoice          Invoice      @relation(fields: [invoiceId], references: [id])
  appliedToInvoice Invoice?     @relation("AppliedCredits", fields: [appliedToInvoiceId], references: [id])

  @@unique([creditNoteNumber, organizationId])
  @@index([organizationId])
  @@index([customerId])
  @@index([organizationId, deletedAt])
  @@map("credit_notes")
}

model PaymentReceived {
  id                 String      @id @default(cuid())
  paymentNumber      String
  customerId         String
  date               DateTime
  amount             Decimal     @db.Decimal(19, 4)
  paymentMode        PaymentMode
  depositToAccountId String
  reference          String?
  notes              String?
  organizationId     String
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  deletedAt          DateTime?

  // Relations
  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer            @relation(fields: [customerId], references: [id])
  allocations  PaymentAllocation[]

  @@unique([paymentNumber, organizationId])
  @@index([organizationId])
  @@index([customerId])
  @@index([organizationId, deletedAt])
  @@map("payments_received")
}

model PaymentAllocation {
  id        String  @id @default(cuid())
  paymentId String
  invoiceId String
  amount    Decimal @db.Decimal(19, 4)

  // Relations
  payment PaymentReceived @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice Invoice         @relation(fields: [invoiceId], references: [id])

  @@index([paymentId])
  @@index([invoiceId])
  @@map("payment_allocations")
}

// ============================================
// VENDORS & PURCHASES
// ============================================

model Vendor {
  id                String    @id @default(cuid())
  name              String
  displayName       String?
  email             String?
  phone             String?
  currency          String    @default("USD")
  taxId             String?
  // Simple address fields for import/export
  address           String?
  city              String?
  country           String?
  bankName          String?
  bankAccount       String?
  // Detailed billing address
  billingStreet     String?
  billingCity       String?
  billingState      String?
  billingPostalCode String?
  billingCountry    String?
  paymentTerms      Int       @default(0)
  organizationId    String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  // Relations
  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expenses      Expense[]
  bills         Bill[]
  vendorCredits VendorCredit[]
  paymentsMade  PaymentMade[]

  @@index([organizationId])
  @@index([name])
  @@map("vendors")
}

model Expense {
  id                   String        @id @default(cuid())
  date                 DateTime
  accountId            String
  vendorId             String?
  amount               Decimal       @db.Decimal(19, 4)
  taxAmount            Decimal       @default(0) @db.Decimal(19, 4)
  taxInclusive         Boolean       @default(false)
  paidThroughAccountId String
  description          String?
  reference            String?
  receiptUrl           String?
  status               ExpenseStatus @default(RECORDED)
  projectId            String?
  organizationId       String
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  deletedAt            DateTime?

  // Relations
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account            Account      @relation("ExpenseAccount", fields: [accountId], references: [id])
  paidThroughAccount Account      @relation("ExpensePaidThrough", fields: [paidThroughAccountId], references: [id])
  vendor             Vendor?      @relation(fields: [vendorId], references: [id])
  project            Project?     @relation(fields: [projectId], references: [id])

  @@index([organizationId])
  @@index([date])
  @@index([organizationId, status])
  @@index([organizationId, vendorId])
  @@index([organizationId, deletedAt, date])
  @@index([organizationId, deletedAt, status])
  @@map("expenses")
}

model Bill {
  id             String     @id @default(cuid())
  billNumber     String
  vendorId       String
  date           DateTime
  billDate       DateTime?
  dueDate        DateTime
  status         BillStatus @default(DRAFT)
  subtotal       Decimal    @default(0) @db.Decimal(19, 4)
  taxAmount      Decimal    @default(0) @db.Decimal(19, 4)
  grandTotal     Decimal    @default(0) @db.Decimal(19, 4)
  total          Decimal?   @db.Decimal(19, 4)
  balanceDue     Decimal    @default(0) @db.Decimal(19, 4)
  currencyCode   String?
  exchangeRate   Decimal?   @db.Decimal(19, 6)
  reference      String?
  notes          String?
  projectId      String?
  organizationId String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  // Relations
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor          Vendor           @relation(fields: [vendorId], references: [id])
  project         Project?         @relation(fields: [projectId], references: [id])
  lines           BillLine[]
  vendorCredits   VendorCredit[]
  billAllocations BillAllocation[]
  appliedCredits  VendorCredit[]   @relation("AppliedVendorCredits")

  @@unique([billNumber, vendorId, organizationId])
  @@index([organizationId])
  @@index([vendorId])
  @@index([status])
  @@index([dueDate])
  @@index([organizationId, status])
  @@index([organizationId, vendorId])
  @@index([organizationId, dueDate])
  @@index([organizationId, deletedAt, status, date])
  @@index([organizationId, deletedAt, balanceDue])
  @@map("bills")
}

model BillLine {
  id          String  @id @default(cuid())
  billId      String
  itemId      String?
  accountId   String?
  taxRateId   String?
  description String
  quantity    Decimal @db.Decimal(19, 4)
  rate        Decimal @db.Decimal(19, 4)
  taxRate     Decimal @default(0) @db.Decimal(5, 2)
  amount      Decimal @default(0) @db.Decimal(19, 4)

  // Relations
  bill    Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  item    Item?    @relation(fields: [itemId], references: [id])
  account Account? @relation(fields: [accountId], references: [id])

  @@index([billId])
  @@map("bill_lines")
}

model VendorCredit {
  id              String    @id @default(cuid())
  creditNumber    String
  vendorId        String
  billId          String
  date            DateTime
  reason          String
  amount          Decimal   @db.Decimal(19, 4)
  appliedToBillId String?
  refundedAt      DateTime?
  organizationId  String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  // Relations
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor        Vendor       @relation(fields: [vendorId], references: [id])
  bill          Bill         @relation(fields: [billId], references: [id])
  appliedToBill Bill?        @relation("AppliedVendorCredits", fields: [appliedToBillId], references: [id])

  @@unique([creditNumber, organizationId])
  @@index([organizationId])
  @@index([vendorId])
  @@map("vendor_credits")
}

model PaymentMade {
  id                String      @id @default(cuid())
  paymentNumber     String
  vendorId          String
  date              DateTime
  amount            Decimal     @db.Decimal(19, 4)
  paymentMode       PaymentMode
  paidFromAccountId String
  reference         String?
  notes             String?
  organizationId    String
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  deletedAt         DateTime?

  // Relations
  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor       Vendor           @relation(fields: [vendorId], references: [id])
  allocations  BillAllocation[]

  @@unique([paymentNumber, organizationId])
  @@index([organizationId])
  @@index([vendorId])
  @@index([organizationId, deletedAt])
  @@map("payments_made")
}

model BillAllocation {
  id        String  @id @default(cuid())
  paymentId String
  billId    String
  amount    Decimal @db.Decimal(19, 4)

  // Relations
  payment PaymentMade @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  bill    Bill        @relation(fields: [billId], references: [id])

  @@index([paymentId])
  @@index([billId])
  @@map("bill_allocations")
}

// ============================================
// INVENTORY
// ============================================

model Item {
  id                 String    @id @default(cuid())
  name               String
  sku                String
  type               ItemType
  unit               String?
  sellingPrice       Decimal   @default(0) @db.Decimal(19, 4)
  salesPrice         Decimal?  @db.Decimal(19, 4) // Alias for import/export
  salesAccountId     String?
  costPrice          Decimal   @default(0) @db.Decimal(19, 4)
  purchasePrice      Decimal?  @db.Decimal(19, 4) // Alias for import/export
  purchaseAccountId  String?
  inventoryAccountId String?
  description        String?
  taxRate            Decimal?  @db.Decimal(5, 2)
  trackInventory     Boolean   @default(true)
  reorderPoint       Int?
  reorderLevel       Int? // Alias for import/export
  currentStock       Int       @default(0)
  isActive           Boolean   @default(true)
  organizationId     String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  // Relations
  organization         Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesAccount         Account?                 @relation("SalesAccount", fields: [salesAccountId], references: [id])
  purchaseAccount      Account?                 @relation("PurchaseAccount", fields: [purchaseAccountId], references: [id])
  inventoryAccount     Account?                 @relation("InventoryAccount", fields: [inventoryAccountId], references: [id])
  quoteLines           QuoteLine[]
  invoiceLines         InvoiceLine[]
  billLines            BillLine[]
  inventoryMovements   InventoryMovement[]
  inventoryAdjustments InventoryAdjustment[]
  inventoryLevels      InventoryLevel[]
  priceListItems       PriceListItem[]
  compositeComponents  CompositeItemComponent[]
  bomOutputs           BOM[]                    @relation("BOMOutput")
  bomItems             BOMItem[]
  reorderAnalysis      ItemReorderAnalysis?
  demandForecasts      ItemDemandForecast[]
  deliveryChallanLines DeliveryChallanLine[]
  costLayers           InventoryCostLayer[]
  transferLines        InventoryTransferLine[]

  @@unique([sku, organizationId])
  @@index([organizationId])
  @@index([type])
  @@index([organizationId, deletedAt])
  @@map("items")
}

model CompositeItem {
  id             String   @id @default(cuid())
  name           String
  sku            String
  sellingPrice   Decimal  @db.Decimal(19, 4)
  description    String?
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  components   CompositeItemComponent[]

  @@unique([sku, organizationId])
  @@index([organizationId])
  @@map("composite_items")
}

model CompositeItemComponent {
  id              String @id @default(cuid())
  compositeItemId String
  itemId          String
  quantity        Int

  // Relations
  compositeItem CompositeItem @relation(fields: [compositeItemId], references: [id], onDelete: Cascade)
  item          Item          @relation(fields: [itemId], references: [id])

  @@index([compositeItemId])
  @@map("composite_item_components")
}

model Warehouse {
  id             String   @id @default(cuid())
  name           String
  code           String
  street         String?
  city           String?
  state          String?
  postalCode     String?
  country        String?
  isDefault      Boolean  @default(false)
  isActive       Boolean  @default(true)
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  // Relations
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inventoryMovements   InventoryMovement[]
  inventoryAdjustments InventoryAdjustment[]
  inventoryLevels      InventoryLevel[]
  deliveryChallanLines DeliveryChallanLine[]
  costLayers           InventoryCostLayer[]
  transfersFrom        InventoryTransfer[]     @relation("TransferFrom")
  transfersTo          InventoryTransfer[]     @relation("TransferTo")

  @@unique([code, organizationId])
  @@index([organizationId])
  @@map("warehouses")
}

model InventoryMovement {
  id             String   @id @default(cuid())
  itemId         String
  warehouseId    String
  quantity       Decimal  @db.Decimal(19, 4)
  type           String // sale, purchase, adjustment, transfer
  movementType   String?  // IN, OUT
  referenceType  String? // invoice, bill, adjustment
  referenceId    String?
  reference      String?
  costPerUnit    Decimal  @default(0) @db.Decimal(19, 4)
  organizationId String
  createdAt      DateTime @default(now())

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item         Item         @relation(fields: [itemId], references: [id])
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id])

  @@index([organizationId])
  @@index([itemId])
  @@index([warehouseId])
  @@index([createdAt])
  @@index([organizationId, itemId])
  @@index([organizationId, itemId, type])
  @@map("inventory_movements")
}

model InventoryLevel {
  id             String   @id @default(cuid())
  itemId         String
  warehouseId    String
  quantity       Decimal  @default(0) @db.Decimal(19, 4)
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item         Item         @relation(fields: [itemId], references: [id])
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id])

  @@unique([itemId, warehouseId])
  @@index([organizationId])
  @@index([itemId])
  @@index([warehouseId])
  @@map("inventory_levels")
}

model InventoryCostLayer {
  id             String   @id @default(cuid())
  itemId         String
  warehouseId    String
  quantity       Decimal  @db.Decimal(19, 4) // remaining quantity in this layer
  originalQty    Decimal  @db.Decimal(19, 4) // original quantity when created
  costPerUnit    Decimal  @db.Decimal(19, 4)
  referenceType  String? // bill, adjustment, production, opening
  referenceId    String?
  organizationId String
  createdAt      DateTime @default(now())

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item         Item         @relation(fields: [itemId], references: [id])
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id])

  @@index([organizationId])
  @@index([itemId, warehouseId])
  @@index([createdAt])
  @@map("inventory_cost_layers")
}

model InventoryAdjustment {
  id               String           @id @default(cuid())
  adjustmentNumber String
  date             DateTime
  warehouseId      String
  itemId           String
  type             AdjustmentType
  quantity         Int
  reason           AdjustmentReason
  accountId        String
  notes            String?
  organizationId   String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id])
  item         Item         @relation(fields: [itemId], references: [id])
  account      Account      @relation(fields: [accountId], references: [id])

  @@unique([adjustmentNumber, organizationId])
  @@index([organizationId])
  @@map("inventory_adjustments")
}

model InventoryTransfer {
  id              String         @id @default(cuid())
  transferNumber  String
  fromWarehouseId String
  toWarehouseId   String
  date            DateTime
  status          TransferStatus @default(PENDING)
  notes           String?
  organizationId  String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  organization  Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromWarehouse Warehouse              @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse              @relation("TransferTo", fields: [toWarehouseId], references: [id])
  lines         InventoryTransferLine[]

  @@unique([transferNumber, organizationId])
  @@index([organizationId])
  @@index([status])
  @@map("inventory_transfers")
}

model InventoryTransferLine {
  id         String  @id @default(cuid())
  transferId String
  itemId     String
  quantity   Decimal @db.Decimal(19, 4)

  // Relations
  transfer InventoryTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  item     Item              @relation(fields: [itemId], references: [id])

  @@index([transferId])
  @@map("inventory_transfer_lines")
}

model PriceList {
  id             String        @id @default(cuid())
  name           String
  description    String?
  type           PriceListType
  adjustment     Decimal       @db.Decimal(10, 4)
  isActive       Boolean       @default(true)
  organizationId String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Relations
  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        PriceListItem[]
  customers    Customer[]

  @@index([organizationId])
  @@map("price_lists")
}

model PriceListItem {
  id          String  @id @default(cuid())
  priceListId String
  itemId      String
  customPrice Decimal @db.Decimal(19, 4)

  // Relations
  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  item      Item      @relation(fields: [itemId], references: [id])

  @@unique([priceListId, itemId])
  @@map("price_list_items")
}

// ============================================
// BANKING
// ============================================

model BankAccount {
  id              String          @id @default(cuid())
  name            String
  accountNumber   String?
  currency        String          @default("USD")
  type            BankAccountType
  systemBalance   Decimal         @default(0) @db.Decimal(19, 4)
  bankBalance     Decimal         @default(0) @db.Decimal(19, 4)
  linkedAccountId String
  isActive        Boolean         @default(true)
  organizationId  String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  // Relations
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  linkedAccount   Account           @relation(fields: [linkedAccountId], references: [id])
  transactions    BankTransaction[]
  bankRules       BankRule[]
  reconciliations Reconciliation[]

  @@index([organizationId])
  @@map("bank_accounts")
}

// ============================================
// RECONCILIATION
// ============================================

model Reconciliation {
  id                 String    @id @default(cuid())
  bankAccountId      String
  reconciliationDate DateTime
  statementDate      DateTime
  statementBalance   Decimal   @db.Decimal(19, 4)
  systemBalance      Decimal   @db.Decimal(19, 4)
  reconciledBalance  Decimal   @db.Decimal(19, 4)
  difference         Decimal   @db.Decimal(19, 4)
  isCompleted        Boolean   @default(false)
  completedAt        DateTime?
  notes              String?
  organizationId     String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relations
  bankAccount  BankAccount  @relation(fields: [bankAccountId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([bankAccountId])
  @@map("reconciliations")
}

model BankTransaction {
  id                String               @id @default(cuid())
  bankAccountId     String
  date              DateTime
  type              BankTransactionType
  amount            Decimal              @db.Decimal(19, 4)
  description       String?
  reference         String?
  payee             String?
  status            ReconciliationStatus @default(PENDING)
  isReconciled      Boolean              @default(false)
  matchedEntityType String?
  matchedEntityId   String?
  confidence        Decimal?             @db.Decimal(5, 2)
  organizationId    String
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bankAccount  BankAccount  @relation(fields: [bankAccountId], references: [id])

  @@index([organizationId])
  @@index([bankAccountId])
  @@index([status])
  @@index([date])
  @@index([organizationId, status])
  @@index([organizationId, bankAccountId, status])
  @@index([organizationId, bankAccountId, status, date])
  @@map("bank_transactions")
}

model BankRule {
  id             String   @id @default(cuid())
  name           String
  bankAccountId  String?
  conditions     Json // Array of condition objects
  action         Json // Action object
  isActive       Boolean  @default(true)
  hitCount       Int      @default(0)
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bankAccount  BankAccount? @relation(fields: [bankAccountId], references: [id])

  @@index([organizationId])
  @@map("bank_rules")
}

// ============================================
// HR & PAYROLL
// ============================================

model Employee {
  id             String    @id @default(cuid())
  employeeId     String
  employeeNumber String? // Alias for display
  name           String
  email          String?
  phone          String?
  department     String?
  jobTitle       String?
  position       String? // Alias for jobTitle
  dateOfJoining  DateTime
  hireDate       DateTime? // Alias for dateOfJoining
  basicSalary    Decimal   @db.Decimal(19, 4)
  baseSalary     Decimal?  @db.Decimal(19, 4) // Alias for basicSalary
  allowances     Json      @default("{}")
  deductions     Json      @default("{}")
  bankAccount    String?
  nationalId     String?
  status         String?   @default("ACTIVE")
  isActive       Boolean   @default(true)
  organizationId String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  attendances  Attendance[]
  payslips     Payslip[]
  aiProfile    EmployeeAiProfile?

  @@unique([employeeId, organizationId])
  @@index([organizationId])
  @@map("employees")
}

model Attendance {
  id             String           @id @default(cuid())
  employeeId     String
  date           DateTime
  status         AttendanceStatus
  checkIn        DateTime?
  checkOut       DateTime?
  notes          String?
  organizationId String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date])
  @@index([organizationId])
  @@index([date])
  @@index([organizationId, employeeId, date])
  @@map("attendances")
}

model PayrollRun {
  id              String        @id @default(cuid())
  month           Int
  year            Int
  periodStart     DateTime?
  periodEnd       DateTime?
  payDate         DateTime?
  status          PayrollStatus @default(DRAFT)
  processedAt     DateTime?
  paidAt          DateTime?
  totalGross      Decimal       @default(0) @db.Decimal(19, 4)
  totalDeductions Decimal       @default(0) @db.Decimal(19, 4)
  totalNet        Decimal       @default(0) @db.Decimal(19, 4)
  journalId       String?       @unique
  organizationId  String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payslips     Payslip[]
  journal      Journal?     @relation(fields: [journalId], references: [id])

  @@unique([month, year, organizationId])
  @@index([organizationId])
  @@index([organizationId, status])
  @@map("payroll_runs")
}

model Payslip {
  id                 String   @id @default(cuid())
  payrollRunId       String
  employeeId         String
  basicSalary        Decimal  @db.Decimal(19, 4)
  baseSalary         Decimal? @db.Decimal(19, 4) // Alias
  allowances         Json     @default("{}")
  // Individual allowance fields for PDF generation
  housingAllowance   Decimal? @default(0) @db.Decimal(19, 4)
  transportAllowance Decimal? @default(0) @db.Decimal(19, 4)
  otherAllowances    Decimal? @default(0) @db.Decimal(19, 4)
  overtime           Decimal? @default(0) @db.Decimal(19, 4)
  bonus              Decimal? @default(0) @db.Decimal(19, 4)
  grossSalary        Decimal  @db.Decimal(19, 4)
  grossPay           Decimal? @db.Decimal(19, 4) // Alias
  lop                Decimal  @default(0) @db.Decimal(19, 4)
  deductions         Json     @default("{}")
  // Individual deduction fields for PDF generation
  gosiEmployee       Decimal? @default(0) @db.Decimal(19, 4)
  incomeTax          Decimal? @default(0) @db.Decimal(19, 4)
  loanDeduction      Decimal? @default(0) @db.Decimal(19, 4)
  otherDeductions    Decimal? @default(0) @db.Decimal(19, 4)
  totalDeductions    Decimal? @default(0) @db.Decimal(19, 4)
  taxes              Decimal  @default(0) @db.Decimal(19, 4)
  netSalary          Decimal  @db.Decimal(19, 4)
  netPay             Decimal? @db.Decimal(19, 4) // Alias

  // Relations
  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee   Employee   @relation(fields: [employeeId], references: [id])

  @@unique([payrollRunId, employeeId])
  @@index([payrollRunId])
  @@map("payslips")
}

// ============================================
// MANUFACTURING
