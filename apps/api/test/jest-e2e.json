{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "diagnostics": false,
        "tsconfig": {
          "types": ["jest", "node"],
          "module": "commonjs",
          "esModuleInterop": true,
          "emitDecoratorMetadata": true,
          "experimentalDecorators": true,
          "skipLibCheck": true
        }
      }
    ]
  },
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/../src/$1",
    "^@mizano/shared-types$": "<rootDir>/../../../packages/shared-types/src/index.ts",
    "^@mizano/validators$": "<rootDir>/../../../packages/validators/src/index.ts"
  },
  "setupFilesAfterEnv": ["./setup-e2e.ts"]
}
